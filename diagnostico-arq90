<!-- ─── NAV ─── -->
<nav class="nav">
  <a href="/arq90" class="nav-logo">PROFILE®</a>
</nav>

<!-- ─── FORM ─── -->
<section class="form-hero">
  <svg aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0">
    <defs>
      <pattern id="dp-form" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
        <circle cx=".5" cy=".5" r=".85" fill="#AAA6A0" fill-opacity=".18"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#dp-form)"/>
  </svg>

  <div class="form-hero-inner">
    <form id="diagForm" novalidate>

      <!-- Campos ocultos de rastreabilidade — preenchidos via JS -->
      <input type="hidden" name="utm_source">
      <input type="hidden" name="utm_medium">
      <input type="hidden" name="utm_campaign">
      <input type="hidden" name="utm_term">
      <input type="hidden" name="utm_content">
      <input type="hidden" name="gclid">
      <input type="hidden" name="fbclid">
      <input type="hidden" name="referrer">
      <input type="hidden" name="landing_page">

      <!-- ═══ STEP 1 ═══ -->
      <div class="form-step active" data-step="1">
        <p class="section-tag">ARQ90 — Diagnóstico Gratuito</p>
        <h1 class="form-h1">Em 30 minutos, vou te mostrar as oportunidades de receita para o seu negócio.</h1>

        <div class="progress-track" aria-hidden="true">
          <span class="progress-seg filled"></span>
          <span class="progress-seg"></span>
        </div>
        <p class="form-step-meta">Passo 1 de 2. Leva menos de 2 minutos.</p>

        <div class="field">
          <label class="field-label" for="field-nome">Como devemos te chamar?<span class="field-required">*</span></label>
          <input class="field-input" type="text" id="field-nome" name="nome" placeholder="Digite seu nome e sobrenome" autocomplete="name" required>
          <span class="field-error">Conta pra gente seu nome e sobrenome.</span>
        </div>

        <div class="field">
          <label class="field-label" for="field-whatsapp">Qual é o WhatsApp que o especialista consegue falar com você?<span class="field-required">*</span></label>
          <input class="field-input" type="tel" id="field-whatsapp" name="whatsapp" placeholder="(11) 91234-5678" autocomplete="tel" inputmode="numeric" data-phone required>
          <span class="field-error">Informe um número de WhatsApp válido com DDD.</span>
        </div>

        <div class="field">
          <label class="field-label" for="field-email">Qual é o seu e-mail de contato?<span class="field-required">*</span></label>
          <input class="field-input" type="email" id="field-email" name="email" placeholder="seu@email.com" autocomplete="email" required>
          <span class="field-error">Informe um e-mail válido.</span>
        </div>

        <div class="form-actions">
          <button type="button" class="btn-form" data-next data-cta-name="CTA - 07 Formulario Passo 1">Continuar para o próximo passo →</button>
        </div>
      </div>

      <!-- ═══ STEP 2 ═══ -->
      <div class="form-step" data-step="2">
        <button type="button" class="btn-back" data-back>← Voltar</button>

        <div class="progress-track" aria-hidden="true">
          <span class="progress-seg filled"></span>
          <span class="progress-seg filled"></span>
        </div>
        <p class="form-step-h">Última etapa. Quanto mais específico, mais útil o diagnóstico.</p>

        <div class="field">
          <label class="field-label" for="field-empresa">Qual o nome da sua empresa?<span class="field-required">*</span></label>
          <input class="field-input" type="text" id="field-empresa" name="empresa" autocomplete="organization" required>
          <span class="field-error">Informe o nome da sua empresa.</span>
        </div>

        <div class="field">
          <label class="field-label" for="field-segmento">Qual o segmento da sua empresa?<span class="field-required">*</span></label>
          <select class="field-select" id="field-segmento" name="segmento" required>
            <option value="" disabled selected hidden>Selecione uma opção</option>
            <option>Educação</option>
            <option>Software</option>
            <option>Serviços</option>
            <option>E-commerce</option>
            <option>Saúde</option>
            <option>Indústria</option>
            <option>Construção Civil/Mercado Imobiliário</option>
            <option>Outro</option>
          </select>
          <span class="field-error">Selecione o segmento da sua empresa.</span>
        </div>

        <div class="form-actions">
          <button type="button" class="btn-form" data-next data-cta-name="CTA - 08 Formulario Envio">Garantir meu diagnóstico gratuito →</button>
        </div>
      </div>

      <!-- ═══ STEP 3 — OBRIGADO ═══ -->
      <div class="form-step" data-step="3">
        <h2 class="thanks-h">Muito Obrigado, <span data-name-output>você</span>!</h2>
        <p class="thanks-sub">Daniel vai entrar em contato via WhatsApp para marcar os 30 minutos do diagnóstico.</p>
        <p class="thanks-body">Enquanto isso, uma provocação: a maioria das empresas que atendemos descobriu no diagnóstico que o problema não era o criativo nem o orçamento. Era o que acontecia depois do clique.</p>

        <p class="thanks-social-label">Conheça nossas redes sociais:</p>
        <div class="thanks-social-links">
          <a href="https://www.linkedin.com/in/daniel-rivelino/" target="_blank" rel="noopener" data-cta-name="CTA - 09 Obrigado LinkedIn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" stroke="#8A2E23" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="2" y="9" width="4" height="12" stroke="#8A2E23" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="4" cy="4" r="2" stroke="#8A2E23" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            LinkedIn
          </a>
          <a href="https://www.instagram.com/profileculture" target="_blank" rel="noopener" data-cta-name="CTA - 10 Obrigado Instagram">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="4" stroke="#8A2E23" stroke-width="1.5"/>
              <circle cx="12" cy="12" r="4" stroke="#8A2E23" stroke-width="1.5"/>
              <circle cx="17.5" cy="6.5" r="1" fill="#8A2E23"/>
            </svg>
            Instagram
          </a>
        </div>
      </div>

    </form>
  </div>
</section>

<!-- ─── FOOTER ─── -->
<footer class="ft">
  <div class="ft-in">
    <span class="ft-copy">© 2026 Profile Culture. Todos os direitos reservados.</span>
    <span class="ft-tagline-b">Growth is architecture.</span>
  </div>
</footer>

<script>
(function () {
  // ─── CONFIG ───
  // Cole aqui a URL de implantação do Apps Script Web App (termina em /exec)
  const ARQ90_WEBHOOK_URL = 'https://script.google.com/a/macros/profileculture.com.br/s/AKfycbxvRAg6WH8EfaOB97HXcfrJCnnAiDgZcYOojppUOEXAEOtAVRNNSyOWw-usi6AV-rp9vg/exec';

  const steps = document.querySelectorAll('.form-step');

  document.querySelectorAll('[data-cta-name]').forEach(el => {
    el.addEventListener('click', () => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'cta_click',
        cta_name: el.dataset.ctaName,
        cta_text: el.textContent.trim(),
        cta_url: el.href || window.location.href
      });
    });
  });

  function showStep(n) {
    steps.forEach(s => s.classList.toggle('active', Number(s.dataset.step) === n));
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function validateStep(stepEl) {
    let valid = true;
    stepEl.querySelectorAll('[required]').forEach(input => {
      const field = input.closest('.field');
      let ok = input.value.trim() !== '';
      if (ok && input.type === 'email') {
        ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value);
      }
      if (ok && input.dataset.phone) {
        ok = input.value.replace(/\D/g, '').length >= 10;
      }
      field.classList.toggle('has-error', !ok);
      if (!ok) valid = false;
    });
    return valid;
  }

  document.querySelectorAll('[data-next]').forEach(btn => {
    btn.addEventListener('click', () => {
      const stepEl = btn.closest('.form-step');
      if (!validateStep(stepEl)) return;

      const next = Number(stepEl.dataset.step) + 1;

      if (next === 3) {
        const fullName = document.getElementById('field-nome').value.trim();
        const firstName = fullName.split(' ')[0] || fullName;
        document.querySelectorAll('[data-name-output]').forEach(el => { el.textContent = firstName; });

        // ─── ENVIO PARA O GOOGLE SHEETS (via Apps Script Web App) ───
        btn.disabled = true;
        const originalLabel = btn.textContent;
        btn.textContent = 'Enviando...';

        const formData = new FormData(document.getElementById('diagForm'));

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'arq90_lead_submit',
          lead_form: 'diagnostico_arq90'
        });

        fetch(ARQ90_WEBHOOK_URL, {
          method: 'POST',
          mode: 'no-cors', // Apps Script não retorna headers CORS; envio "fire-and-forget"
          body: formData
        })
          .catch(err => console.error('Erro ao enviar lead para o Sheets:', err))
          .finally(() => {
            btn.disabled = false;
            btn.textContent = originalLabel;
          });
      }

      showStep(next);
    });
  });

  document.querySelectorAll('[data-back]').forEach(btn => {
    btn.addEventListener('click', () => {
      const stepEl = btn.closest('.form-step');
      showStep(Number(stepEl.dataset.step) - 1);
    });
  });

  // ─── MÁSCARA DE WHATSAPP ───
  const phone = document.getElementById('field-whatsapp');
  phone.addEventListener('input', () => {
    let v = phone.value.replace(/\D/g, '').slice(0, 11);
    if (v.length > 6) v = v.replace(/(\d{2})(\d{5})(\d{0,4})/, '($1) $2-$3');
    else if (v.length > 2) v = v.replace(/(\d{2})(\d{0,5})/, '($1) $2');
    else if (v.length > 0) v = '(' + v;
    phone.value = v.trim();
  });

  // ─── CAPTURA DE RASTREABILIDADE (UTMs, click IDs, origem) ───
  const params = new URLSearchParams(window.location.search);
  ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'].forEach(key => {
    const el = document.querySelector(`[name="${key}"]`);
    if (el) el.value = params.get(key) || '';
  });
  document.querySelector('[name="referrer"]').value = document.referrer || '';
  document.querySelector('[name="landing_page"]').value = window.location.href;

  showStep(1);
})();
</script>
</body>
</html>
